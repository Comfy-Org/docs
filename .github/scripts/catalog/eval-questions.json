{
  "description": "Fixed questions for the Comfy Docs MCP catalog. Run with: node .github/scripts/catalog/eval-mcp.mjs --url https://docs.comfy.org/mcp",
  "questions": [
    {
      "id": 1,
      "question": "What video models are on Router?",
      "call": { "tool": "search", "query": "Router video models" },
      "expect": { "pageStartsWith": "catalog/router/video", "within": 3 }
    },
    {
      "id": 2,
      "question": "List Router video models from the catalog page",
      "call": { "tool": "fs", "command": "cat /catalog/router/video.mdx" },
      "expect": { "exit": 0, "contains": ["kling/kling-v3"] }
    },
    {
      "id": 3,
      "question": "Kling video generation",
      "call": { "tool": "search", "query": "Kling video generation" },
      "expect": { "pageStartsWith": "catalog/models/kling/", "within": 5 }
    },
    {
      "id": 4,
      "question": "Flux 2 text to image",
      "call": { "tool": "search", "query": "Flux 2 text to image" },
      "expect": { "pageStartsWith": "catalog/models/black-forest-labs/flux-2-dev", "within": 5 }
    },
    {
      "id": 5,
      "question": "Price of kling/kling-v3",
      "call": { "tool": "fs", "command": "cat /catalog/models/kling/kling-v3.mdx" },
      "expect": { "exit": 0, "contains": ["Model ID: kling/kling-v3", "credits"] }
    },
    {
      "id": 6,
      "question": "Run Flux 2 Dev locally",
      "call": { "tool": "fs", "command": "cat /catalog/models/black-forest-labs/flux-2-dev.mdx" },
      "expect": { "exit": 0, "contains": ["flux2_dev_fp8mixed.safetensors", "diffusion_models"] }
    },
    {
      "id": 7,
      "question": "What products does Comfy have?",
      "call": { "tool": "search", "query": "What products does Comfy have" },
      "expect": { "pageStartsWith": "catalog/products", "within": 3 }
    },
    {
      "id": 8,
      "question": "Filter catalog pages by product tag line",
      "call": { "tool": "fs", "command": "rg -l \"Product: router\" /catalog" },
      "expect": { "exit": 0, "contains": ["/catalog/"] }
    },
    {
      "id": 9,
      "question": "What changed on Router recently?",
      "call": { "tool": "fs", "command": "cat /catalog/changes/router.mdx" },
      "expect": { "exit": 0, "contains": ["Product: router"] }
    },
    {
      "id": 10,
      "question": "Per-product skills are served",
      "call": { "tool": "resources" },
      "expect": { "resourceOtherThan": "comfy" }
    },
    {
      "id": 11,
      "question": "Guard: install ComfyUI Desktop on Mac",
      "guard": true,
      "call": { "tool": "search", "query": "install ComfyUI Desktop on Mac" },
      "expect": { "pageEquals": "installation/desktop/macos", "within": 1 }
    },
    {
      "id": 12,
      "question": "Guard: Comfy Cloud pricing credits",
      "guard": true,
      "call": { "tool": "search", "query": "Comfy Cloud pricing credits" },
      "expect": { "pageIn": ["support/subscription/subscribing", "get_started/cloud"], "within": 3 }
    },
    {
      "id": 13,
      "question": "Guard: Comfy Cloud pricing credits (zh)",
      "guard": true,
      "call": { "tool": "search", "query": "Comfy Cloud pricing credits", "language": "zh" },
      "expect": { "pageIn": ["zh/support/subscription/subscribing", "zh/support/subscription/changing-plan"], "within": 3 }
    }
  ]
}
