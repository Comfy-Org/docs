{
  "description": "Fixed questions for the Comfy Docs MCP catalog. Run against a PR preview only (production runs show up in Mintlify's agent search analytics): node .github/scripts/catalog/eval-mcp.mjs --url https://<preview>/mcp",
  "questions": [
    {
      "id": 1,
      "question": "What video models are on Router?",
      "call": {
        "tool": "search",
        "query": "Router video models"
      },
      "expect": {
        "pageStartsWith": "catalog/router/video",
        "within": 3
      }
    },
    {
      "id": 2,
      "question": "List Router video models from the catalog page",
      "call": {
        "tool": "fs",
        "command": "cat /catalog/router/video.mdx"
      },
      "expect": {
        "exit": 0,
        "contains": [
          "kling/kling-v3"
        ]
      }
    },
    {
      "id": 3,
      "question": "Kling video generation",
      "call": {
        "tool": "search",
        "query": "Kling video generation"
      },
      "expect": {
        "pageStartsWith": "catalog/models/kling/",
        "within": 5
      }
    },
    {
      "id": 4,
      "question": "Flux 2 text to image",
      "call": {
        "tool": "search",
        "query": "Flux 2 text to image"
      },
      "expect": {
        "pageStartsWithAny": [
          "catalog/models/bfl/flux-2",
          "tutorials/flux/flux-2",
          "tutorials/partner-nodes/black-forest-labs/flux-2",
          "built-in-nodes/ComfyCloudFlux2",
          "built-in-nodes/Flux2"
        ],
        "within": 5
      }
    },
    {
      "id": 5,
      "question": "Price of kling/kling-v3",
      "call": {
        "tool": "fs",
        "command": "cat /catalog/models/kling/kling-v3.mdx"
      },
      "expect": {
        "exit": 0,
        "contains": [
          "Model ID: kling/kling-v3",
          "credits"
        ]
      }
    },
    {
      "id": 6,
      "question": "Run Flux 2 Dev locally",
      "call": {
        "tool": "fs",
        "command": "cat /catalog/models/bfl/flux-2-dev.mdx"
      },
      "expect": {
        "exit": 0,
        "contains": [
          "flux2_dev_fp8mixed.safetensors",
          "diffusion_models"
        ]
      }
    },
    {
      "id": 7,
      "question": "What products does Comfy have?",
      "call": {
        "tool": "search",
        "query": "What products does Comfy have"
      },
      "expect": {
        "pageStartsWith": "catalog/products",
        "within": 3
      }
    },
    {
      "id": 8,
      "question": "Filter catalog pages by product tag line",
      "call": {
        "tool": "fs",
        "command": "rg -l \"Product: router\" /catalog"
      },
      "expect": {
        "exit": 0,
        "contains": [
          "/catalog/"
        ]
      }
    },
    {
      "id": 9,
      "question": "What changed on Router recently?",
      "call": {
        "tool": "fs",
        "command": "cat /catalog/changes/router.mdx"
      },
      "expect": {
        "exit": 0,
        "contains": [
          "Product: router"
        ]
      }
    },
    {
      "id": 10,
      "question": "Per-product skills are served",
      "call": {
        "tool": "resources"
      },
      "expect": {
        "resourceOtherThan": "comfy"
      }
    },
    {
      "id": 11,
      "question": "Guard: install ComfyUI Desktop on Mac",
      "guard": true,
      "call": {
        "tool": "search",
        "query": "install ComfyUI Desktop on Mac"
      },
      "expect": {
        "pageEquals": "installation/desktop/macos",
        "within": 1
      }
    },
    {
      "id": 12,
      "question": "Guard: Comfy Cloud pricing credits",
      "guard": true,
      "call": {
        "tool": "search",
        "query": "Comfy Cloud pricing credits"
      },
      "expect": {
        "pageIn": [
          "support/subscription/subscribing",
          "get_started/cloud"
        ],
        "within": 3
      }
    },
    {
      "id": 13,
      "question": "Guard: Comfy Cloud pricing credits (zh)",
      "guard": true,
      "call": {
        "tool": "search",
        "query": "Comfy Cloud pricing credits",
        "language": "zh"
      },
      "expect": {
        "pageIn": [
          "zh/support/subscription/subscribing",
          "zh/support/subscription/changing-plan"
        ],
        "within": 3
      }
    },
    {
      "id": 14,
      "question": "Run MiniMax H3 locally (top agent page)",
      "call": {
        "tool": "search",
        "query": "run minimax h3 locally"
      },
      "expect": {
        "pageStartsWithAny": [
          "catalog/models/minimax/minimax-h3",
          "tutorials/video/minimax/"
        ],
        "within": 1
      }
    },
    {
      "id": 15,
      "question": "Wan 2.2 model files (top agent page)",
      "call": {
        "tool": "search",
        "query": "wan 2.2 model files"
      },
      "expect": {
        "pageStartsWithAny": [
          "catalog/models/wan/wan2-2",
          "tutorials/video/wan/wan2_2"
        ],
        "within": 3
      }
    },
    {
      "id": 16,
      "question": "Wan 2.2 files and folders from the catalog",
      "call": {
        "tool": "fs",
        "command": "cat /catalog/models/wan/wan2-2.mdx"
      },
      "expect": {
        "exit": 0,
        "contains": [
          "wan2.2_",
          "models/diffusion_models/"
        ]
      }
    },
    {
      "id": 17,
      "question": "Open-weights models to run locally",
      "call": {
        "tool": "search",
        "query": "open weights models I can run locally in ComfyUI"
      },
      "expect": {
        "pageStartsWith": "catalog/local/models",
        "within": 3
      }
    },
    {
      "id": 18,
      "question": "What's new in Comfy Router",
      "call": {
        "tool": "search",
        "query": "what's new in Comfy Router"
      },
      "expect": {
        "pageStartsWith": "catalog/changes/router",
        "within": 3
      }
    },
    {
      "id": 19,
      "question": "What's new in Comfy Cloud",
      "call": {
        "tool": "search",
        "query": "what's new in Comfy Cloud"
      },
      "expect": {
        "pageStartsWith": "catalog/changes/cloud",
        "within": 3
      }
    },
    {
      "id": 20,
      "question": "What's new in ComfyUI",
      "call": {
        "tool": "search",
        "query": "what's new in ComfyUI"
      },
      "expect": {
        "pageIn": [
          "catalog/changes/local",
          "changelog/index",
          "changelog"
        ],
        "within": 3
      }
    },
    {
      "id": 21,
      "question": "Filter catalog by output tag line",
      "call": {
        "tool": "fs",
        "command": "rg -l \"Output: .*video\" /catalog/models"
      },
      "expect": {
        "exit": 0,
        "contains": [
          "/catalog/models/kling/kling-v3",
          "/catalog/models/minimax/minimax-h3"
        ]
      }
    },
    {
      "id": 22,
      "question": "Guard: ksampler",
      "guard": true,
      "call": {
        "tool": "search",
        "query": "ksampler"
      },
      "expect": {
        "pageEquals": "built-in-nodes/KSampler",
        "within": 1
      }
    },
    {
      "id": 23,
      "question": "Guard: 211 credits = $1 concurrency",
      "guard": true,
      "call": {
        "tool": "search",
        "query": "211 credits = $1 concurrency"
      },
      "expect": {
        "pageEquals": "tutorials/partner-nodes/concurrency-limits",
        "within": 1
      }
    }
  ]
}
